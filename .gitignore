.env

# --- Python / Byte-compiled files ---
__pycache__/
*.py[cod]
*$py.class

# --- Django Specific ---
/portfolio_backend/db.sqlite3
/portfolio_backend/db.sqlite3-journal
/portfolio_backend/local_settings.py
/portfolio_backend/.env
/portfolio_backend/*.log

# --- Media and Static Files ---
# Ignore user-uploaded content (e.g., project screenshots or blog images)
/portfolio_backend/media/
# Ignore collected static files (generated by 'collectstatic')
/portfolio_backend/staticfiles/
/portfolio_backend/static/

# --- App Specific (if they generate local temporary files) ---
# Example: If your 'projects' app generates PDF reports or exports
# projects/exports/

# --- Environment & Virtual Environments ---
/portfolio_backend/.venv/
/portfolio_backend/venv/
/portfolio_backend/env/
/portfolio_backend/ENV/
/portfolio_backend/bin/
/portfolio_backend/lib/
/portfolio_backend/include/

# --- IDEs and Editors ---
/portfolio_backend/.vscode/
/portfolio_backend/.idea/
/portfolio_backend/*.swp
/portfolio_backend/*.swo
/portfolio_backend/.DS_Store

# --- Deployment / Distribution ---
/portfolio_backend/*.tar
/portfolio_backend/*.zip
/portfolio_backend/*.gz
/portfolio_backend/dist/
/portfolio_backend/build/
